<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:OvertonesPlayground"
             xmlns:conv="clr-namespace:OvertonesPlayground.Converters"
             x:Class="OvertonesPlayground.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:HexColorConverter x:Key="HexColor" />
            <conv:BoolToPlayPauseIconConverter x:Key="PlayPauseIcon" />
            <conv:BoolToAccentColorConverter x:Key="BoolToAccent" />
            <conv:InvertedBoolConverter x:Key="InvertedBool" />
            <conv:RecordButtonLabelConverter x:Key="RecordButtonLabel" />
            <conv:StringToBoolConverter x:Key="StringToBool" />
            <conv:EnumEqualsConverter x:Key="EnumEquals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
