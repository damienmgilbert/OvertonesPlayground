<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:behaviors="clr-namespace:CommunityToolkit.Maui.Behaviors;assembly=CommunityToolkit.Maui"
             x:Class="OvertonesPlayground.Controls.LabeledSlider"
             x:Name="Root">

    <Grid ColumnDefinitions="Auto,*,84" ColumnSpacing="10">
        <Label Grid.Column="0"
               Text="{Binding LabelText, Source={x:Reference Root}}"
               VerticalOptions="Center"
               LineBreakMode="TailTruncation" />

        <Slider Grid.Column="1"
                x:Name="ValueSlider"
                SemanticProperties.Description="{Binding LabelText, Source={x:Reference Root}}"
                Minimum="{Binding Minimum, Source={x:Reference Root}}"
                Maximum="{Binding Maximum, Source={x:Reference Root}}"
                Value="{Binding Value, Source={x:Reference Root}}"
                VerticalOptions="Center" />

        <!-- A Hint, not a Description: on Android a content description on an EditText can replace the value that a
             screen reader reads out. -->
        <Entry Grid.Column="2"
               x:Name="ValueEntry"
               SemanticProperties.Hint="{Binding LabelText, Source={x:Reference Root}, StringFormat='Type an exact value for {0}'}"
               Keyboard="Numeric"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               TextChanged="OnEntryTextChanged">
            <Entry.Behaviors>
                <behaviors:NumericValidationBehavior
                    MinimumValue="{Binding Minimum, Source={x:Reference Root}}"
                    MaximumValue="{Binding Maximum, Source={x:Reference Root}}"
                    MaximumDecimalPlaces="{Binding Digits, Source={x:Reference Root}}"
                    InvalidStyle="{StaticResource InvalidEntryStyle}" />
            </Entry.Behaviors>
        </Entry>
    </Grid>

</ContentView>
