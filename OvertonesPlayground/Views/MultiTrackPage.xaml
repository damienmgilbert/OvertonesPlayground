<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.MultiTrackPage" AutomationId="multitrack-page" SafeAreaEdges="All"
             x:DataType="vm:MultiTrackViewModel"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <DataTemplate x:Key="TrackClipTemplate" x:DataType="vm:TrackClipViewModel">
            <Border AutomationId="{Binding TrackClip.Id, StringFormat='multitrack-clip-{0}'}" StrokeShape="RoundRectangle 8" Padding="10,8" Margin="0,0,0,8">
                <VerticalStackLayout Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                            <Label Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding ClipName}" LineBreakMode="TailTruncation" />
                            <Label Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding DurationText}" TextColor="{DynamicResource TextFillColorSecondary}" />
                        </VerticalStackLayout>
                        <Button AutomationId="{Binding TrackClip.Id, StringFormat='multitrack-clip-{0}-remove'}" Grid.Column="1" controls:Icon.Glyph="{x:Static models:IconFont.Close}" controls:Icon.Size="20" SemanticProperties.Description="{Binding ClipName, StringFormat='Remove {0}'}" Padding="10,6"
                                TextColor="{DynamicResource SystemFillColorCritical}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TrackViewModel}}, Path=RemoveClipCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                    <controls:LabeledSlider AutomationId="{Binding TrackClip.Id, StringFormat='multitrack-clip-{0}-start'}" LabelText="Start (s)" Minimum="0" Maximum="300" Digits="2" Value="{Binding StartOffsetSeconds}" />
                    <controls:LabeledSlider AutomationId="{Binding TrackClip.Id, StringFormat='multitrack-clip-{0}-gain'}" LabelText="Gain (dB)" Minimum="-24" Maximum="24" Digits="1" Value="{Binding GainDb}" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TrackTemplate" x:DataType="vm:TrackViewModel">
            <Border AutomationId="{Binding Number, StringFormat='multitrack-track-{0}'}" StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,16">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding IsDimmed}" Value="True">
                        <Setter Property="Opacity" Value="0.45" />
                    </DataTrigger>
                </Border.Triggers>

                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <Entry AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-name'}" Grid.Column="0" Text="{Binding Name}" FontAttributes="Bold" FontSize="15" />
<Button AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-mute'}" Grid.Column="1" Text="M" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="12"
                                Command="{Binding ToggleMuteCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsMuted}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
<Button AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-solo'}" Grid.Column="2" Text="S" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="12"
                                Command="{Binding ToggleSoloCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsSoloed}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>

                    <controls:LabeledSlider AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-volume'}" LabelText="Volume" Minimum="0" Maximum="1" Digits="2" Value="{Binding Volume}" />
                    <controls:LabeledSlider AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-pan'}" LabelText="Pan" Minimum="-1" Maximum="1" Digits="2" Value="{Binding Pan}" />

                    <VerticalStackLayout AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-clips'}" BindableLayout.ItemsSource="{Binding Clips}"
                                         BindableLayout.ItemTemplate="{StaticResource TrackClipTemplate}" />

                    <HorizontalStackLayout Spacing="10">
                        <Button AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-add-clip'}" Text="Add Clip" controls:Icon.Glyph="{x:Static models:IconFont.Add}" Clicked="OnAddClipClicked" />
                        <Button AutomationId="{Binding Number, StringFormat='multitrack-track-{0}-merge'}" Text="Merge" controls:Icon.Glyph="{x:Static models:IconFont.Link}" Command="{Binding MergeClipsCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </DataTemplate>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="multitrack-mix-all" Text="Mix All" controls:Icon.Glyph="{x:Static models:IconFont.Tune}" controls:Icon.Size="24" Command="{Binding MixAllToStartCommand}" />
        <ToolbarItem AutomationId="multitrack-bounce" Text="Bounce" controls:Icon.Glyph="{x:Static models:IconFont.Download}" controls:Icon.Size="24" Command="{Binding BounceCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <VerticalStackLayout Spacing="2">
                <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Project name" TextColor="{DynamicResource TextFillColorSecondary}" />
                <Entry AutomationId="multitrack-project-name" Text="{Binding ProjectName}" FontAttributes="Bold" FontSize="16" Placeholder="Mix" />
            </VerticalStackLayout>

            <VerticalStackLayout AutomationId="multitrack-tracks" BindableLayout.ItemsSource="{Binding Tracks}"
                                 BindableLayout.ItemTemplate="{StaticResource TrackTemplate}" />

            <ActivityIndicator AutomationId="multitrack-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label AutomationId="multitrack-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
