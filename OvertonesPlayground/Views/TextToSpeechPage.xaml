<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.TextToSpeechPage" AutomationId="texttospeech-page" SafeAreaEdges="All"
             x:DataType="vm:TextToSpeechViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <controls:IconLabel Style="{StaticResource SubtitleTextBlockStyle}" Caption="Text to Speech" Glyph="{x:Static models:IconFont.Text_to_speech}" />
            <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Type something, Generate &amp; Play to preview it, then Save to keep it in your library (and your device's Music folder)."
                   TextColor="{DynamicResource TextFillColorSecondary}" />

            <Editor AutomationId="texttospeech-text" ToolTipProperties.Text="The text to be spoken." Placeholder="Type the text to speak..." Text="{Binding Text}" AutoSize="TextChanges" MinimumHeightRequest="120" />

            <HorizontalStackLayout Spacing="12">
                <Button AutomationId="texttospeech-generate" ToolTipProperties.Text="Turn the text into speech and play it." Style="{StaticResource AccentButtonStyle}" Text="Generate &amp; Play" controls:Icon.Glyph="{x:Static models:IconFont.Play_arrow}" Command="{Binding GenerateCommand}" />
                <Button AutomationId="texttospeech-save" ToolTipProperties.Text="Save the speech to your library." Style="{StaticResource AccentButtonStyle}" Text="Save" controls:Icon.Glyph="{x:Static models:IconFont.Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            </HorizontalStackLayout>

            <GraphicsView SemanticProperties.Description="Waveform preview of the generated speech" AutomationId="texttospeech-waveform" x:Name="WaveformView" HeightRequest="120" BackgroundColor="{DynamicResource SolidBackgroundFillColorTertiary}" />

            <ActivityIndicator AutomationId="texttospeech-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label AutomationId="texttospeech-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
