<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.MixerPage"
             x:DataType="vm:MixerViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Stop All" Command="{Binding StopAllCommand}" />
    </ContentPage.ToolbarItems>

    <CollectionView ItemsSource="{Binding Channels}" Margin="12">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="4" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:MixerChannelViewModel">
                <Border StrokeShape="RoundRectangle 14" Padding="14" HorizontalOptions="Fill">
                    <Grid RowDefinitions="Auto,Auto,220,Auto,Auto,Auto" RowSpacing="10">
                        <Label Grid.Row="0" Text="{Binding Name}" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                        <Label Grid.Row="1" Text="{Binding SourceLabel}" FontSize="11"
                               TextColor="{StaticResource Gray500}" HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />

                        <Slider Grid.Row="2"
                                Rotation="270"
                                WidthRequest="220"
                                HorizontalOptions="Center"
                                Minimum="0" Maximum="1"
                                Value="{Binding Volume}" />

                        <controls:LabeledSlider Grid.Row="3" LabelText="Pan" Minimum="-1" Maximum="1" Digits="2" Value="{Binding Pan}" />

                        <HorizontalStackLayout Grid.Row="4" Spacing="8" HorizontalOptions="Center">
                            <Button Text="M" WidthRequest="42" Padding="0"
                                    BackgroundColor="{Binding IsMuted, Converter={StaticResource BoolToAccent}}"
                                    Command="{Binding ToggleMuteCommand}" />
                            <Button Text="S" WidthRequest="42" Padding="0"
                                    Command="{Binding ToggleSoloCommand}" />
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="5" Spacing="8" HorizontalOptions="Center">
                            <Button Text="Load"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MixerViewModel}}, Path=LoadSampleCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}"
                                    IsEnabled="{Binding HasSource}"
                                    Command="{Binding TogglePlaybackCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
