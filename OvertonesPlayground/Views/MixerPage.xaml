<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.MixerPage" AutomationId="mixer-page"
             x:DataType="vm:MixerViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="mixer-stop-all" Text="Stop All" controls:Icon.Glyph="{x:Static models:IconFont.Stop}" controls:Icon.Size="24" Command="{Binding StopAllCommand}" />
    </ContentPage.ToolbarItems>

    <!-- Channel strips sit side by side like a real mixing console, scrolling horizontally as tracks are added,
         instead of wrapping into a card grid. -->
    <CollectionView AutomationId="mixer-channels" ItemsSource="{Binding Channels}" Margin="12">
        <CollectionView.ItemsLayout>
            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="2" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:MixerChannelViewModel">
                <Border AutomationId="{Binding Number, StringFormat='mixer-channel-{0}'}" StrokeShape="RoundRectangle 6,6,0,0" Padding="10,12" VerticalOptions="Fill">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDimmed}" Value="True">
                            <Setter Property="Opacity" Value="0.45" />
                        </DataTrigger>
                    </Border.Triggers>

                    <Grid RowDefinitions="4,Auto,Auto,220,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">

                        <!-- Track color tab, mirroring the Launchpad's per-pad colors for at-a-glance identity. -->
                        <BoxView Grid.Row="0" HeightRequest="4" CornerRadius="2"
                                 Color="{Binding ColorHex, Converter={StaticResource HexColor}}" />

                        <Entry AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-name'}" Grid.Row="1" Text="{Binding Name}" FontAttributes="Bold" FontSize="13"
                               HorizontalTextAlignment="Center" />

                        <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-source'}" Grid.Row="2" Text="{Binding SourceLabel}"
                               TextColor="{DynamicResource TextFillColorSecondary}" HorizontalTextAlignment="Center"
                               LineBreakMode="TailTruncation" />

                        <!-- Vertical fader: Rotation is a render-only transform, so the Slider still lays out at its
                             unrotated WidthRequest/HeightRequest - that's why the row height matches WidthRequest. -->
                        <Slider AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-volume-slider'}" Grid.Row="3"
                                Rotation="270"
                                WidthRequest="220"
                                HeightRequest="36"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Minimum="0" Maximum="1"
                                Value="{Binding Volume}" />

                        <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-volume-text'}" Grid.Row="4" Text="{Binding Volume, StringFormat='{0:P0}'}"
                               TextColor="{DynamicResource TextFillColorSecondary}" HorizontalTextAlignment="Center" />

                        <Slider AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-pan-slider'}" Grid.Row="5" Minimum="-1" Maximum="1" Value="{Binding Pan}" />

                        <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-pan-text'}" Grid.Row="6" Text="{Binding Pan, StringFormat='Pan {0:+0.00;-0.00;C}'}"
                               TextColor="{DynamicResource TextFillColorSecondary}" HorizontalTextAlignment="Center" />

                        <HorizontalStackLayout Grid.Row="7" Spacing="6" HorizontalOptions="Center">
<Button AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-mute'}" Text="M" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="12"
                                    Command="{Binding ToggleMuteCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsMuted}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                        <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
<Button AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-solo'}" Text="S" WidthRequest="48" HeightRequest="48" Padding="0" FontSize="12"
                                    Command="{Binding ToggleSoloCommand}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsSoloed}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                        <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                        <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Row="8" Spacing="6" HorizontalOptions="Center">
                            <Button AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-load'}" controls:Icon.Glyph="{x:Static models:IconFont.Folder_open}" controls:Icon.Size="24" SemanticProperties.Description="{Binding Number, StringFormat='Load a sample into channel {0}'}" WidthRequest="48" HeightRequest="48" Padding="0"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MixerViewModel}}, Path=LoadSampleCommand}"
                                    CommandParameter="{Binding .}" />
                            <Button AutomationId="{Binding Number, StringFormat='mixer-channel-{0}-play'}" controls:Icon.Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" controls:Icon.Size="24" SemanticProperties.Description="{Binding IsPlaying, Converter={StaticResource PlayPauseLabel}}"
                                    WidthRequest="48" HeightRequest="48" Padding="0"
                                    IsEnabled="{Binding HasSource}"
                                    Command="{Binding TogglePlaybackCommand}" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>

</ContentPage>
