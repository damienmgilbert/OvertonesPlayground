<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             x:Class="OvertonesPlayground.Views.LibraryPage" AutomationId="library-page"
             x:DataType="vm:LibraryViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="library-import" Text="Import" controls:Icon.Glyph="{x:Static models:IconFont.Upload}" controls:Icon.Size="24" Command="{Binding ImportCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">

        <HorizontalStackLayout x:Name="ViewModes" HorizontalOptions="Start" Grid.Row="0" Spacing="8" Padding="16,10">
            <Button AutomationId="library-view-list" ToolTipProperties.Text="Show the clips as a compact list" Text="List" controls:Icon.Glyph="{x:Static models:IconFont.View_list}" Padding="12,6" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.List}" />
            <Button AutomationId="library-view-detail" ToolTipProperties.Text="Show each clip as a card with its details." Text="Detail" controls:Icon.Glyph="{x:Static models:IconFont.Table_rows}" Padding="12,6" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.Detail}" />
            <Button AutomationId="library-view-tile" ToolTipProperties.Text="Show the clips as a grid of tiles. Tap a tile to play it, double-tap to edit." Text="Tile" controls:Icon.Glyph="{x:Static models:IconFont.Grid_view}" Padding="12,6" Command="{Binding SetViewModeCommand}" CommandParameter="{x:Static models:LibraryViewMode.Tile}" />
        </HorizontalStackLayout>

        <!-- Import progress and the outcome of the last import -->
        <VerticalStackLayout Grid.Row="1">
            <VerticalStackLayout AutomationId="library-import-progress-panel" IsVisible="{Binding IsImporting}" Padding="16,0,16,10" Spacing="6">
                <Label AutomationId="library-import-status" Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding ImportStatus}" TextColor="{DynamicResource TextFillColorSecondary}" />
                <ProgressBar AutomationId="library-import-progress" Progress="{Binding ImportFraction}" SemanticProperties.Description="Import progress" />
            </VerticalStackLayout>
            <Label AutomationId="library-status" Padding="16,0,16,10" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}"
                   IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}" />
        </VerticalStackLayout>

        <RefreshView AutomationId="library-refresh" Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding LoadCommand}">
            <Grid>

                <!-- List: compact single-column rows -->
                <CollectionView AutomationId="library-list" ItemsSource="{Binding Clips}"
                                 SelectionMode="None"
                                 IsVisible="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=List}">
                    <CollectionView.EmptyView>
                        <Label AutomationId="library-list-empty"
                               Text="No audio clips yet. Import a file or record one in Audio Recorder."
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioClip">
                            <Grid AutomationId="{Binding Id, StringFormat='library-list-clip-{0}'}" ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="8" Padding="16,10">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Style="{StaticResource BodyStrongTextBlockStyle}" Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                    <Label Style="{StaticResource CaptionTextBlockStyle}" Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}" TextColor="{DynamicResource TextFillColorSecondary}" />
                                </VerticalStackLayout>
                                <Button AutomationId="{Binding Id, StringFormat='library-list-clip-{0}-play'}" Grid.Column="1" controls:Icon.Glyph="{x:Static models:IconFont.Play_arrow}" controls:Icon.Size="22" SemanticProperties.Description="{Binding Name, StringFormat='Play {0}'}" Padding="10,6"
                                        Clicked="OnPlayClicked" />
                                <Button AutomationId="{Binding Id, StringFormat='library-list-clip-{0}-edit'}" Grid.Column="2" controls:Icon.Glyph="{x:Static models:IconFont.Edit}" controls:Icon.Size="22" SemanticProperties.Description="{Binding Name, StringFormat='Edit {0}'}" Padding="10,6"
                                        Clicked="OnEditClicked" />
                                <Button AutomationId="{Binding Id, StringFormat='library-list-clip-{0}-export'}" Grid.Column="3" controls:Icon.Glyph="{x:Static models:IconFont.Download}" controls:Icon.Size="22" SemanticProperties.Description="{Binding Name, StringFormat='Export {0}'}" Padding="10,6" Clicked="OnExportClicked" />
                                <Button AutomationId="{Binding Id, StringFormat='library-list-clip-{0}-delete'}" Grid.Column="4" controls:Icon.Glyph="{x:Static models:IconFont.Delete}" controls:Icon.Size="22" SemanticProperties.Description="{Binding Name, StringFormat='Delete {0}'}" Padding="10,6" TextColor="{DynamicResource SystemFillColorCritical}"
                                        Clicked="OnDeleteClicked" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Detail: full-information cards -->
                <CollectionView AutomationId="library-detail" ItemsSource="{Binding Clips}"
                                 SelectionMode="None"
                                 IsVisible="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=Detail}">
                    <CollectionView.EmptyView>
                        <Label AutomationId="library-detail-empty"
                               Text="No audio clips yet. Import a file or record one in Audio Recorder."
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioClip">
                            <Border AutomationId="{Binding Id, StringFormat='library-detail-clip-{0}'}" StrokeShape="RoundRectangle 12" Padding="14" Margin="4">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                    <Label Style="{StaticResource BodyStrongTextBlockStyle}" Grid.Row="0" Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="1" Text="{Binding Duration, StringFormat='{0:mm\\:ss}'}" TextColor="{DynamicResource TextFillColorSecondary}" />
                                    <Label Style="{StaticResource CaptionTextBlockStyle}" Grid.Row="2" Text="{Binding PublicStorageLocation}" TextColor="{DynamicResource TextFillColorSecondary}"
                                           IsVisible="{Binding PublicStorageLocation, Converter={StaticResource StringToBool}}"
                                           LineBreakMode="TailTruncation" />
                                    <HorizontalStackLayout Grid.Row="3" Spacing="10">
                                        <Button AutomationId="{Binding Id, StringFormat='library-detail-clip-{0}-play'}" ToolTipProperties.Text="{Binding Name, StringFormat='Play {0}.'}" Text="Play" controls:Icon.Glyph="{x:Static models:IconFont.Play_arrow}"
                                                Padding="14,6"
                                                Clicked="OnPlayClicked" />
                                        <Button AutomationId="{Binding Id, StringFormat='library-detail-clip-{0}-edit'}" ToolTipProperties.Text="{Binding Name, StringFormat='Edit {0}: trim it, mix it or change its sound.'}" Text="Edit" controls:Icon.Glyph="{x:Static models:IconFont.Edit}"
                                                Padding="14,6"
                                                Clicked="OnEditClicked" />
                                        <Button AutomationId="{Binding Id, StringFormat='library-detail-clip-{0}-export'}" ToolTipProperties.Text="{Binding Name, StringFormat='Save a copy of {0} to the Music folder on your device.'}" Text="Export" controls:Icon.Glyph="{x:Static models:IconFont.Download}"
                                                Padding="14,6"
                                                Clicked="OnExportClicked" />
                                        <Button AutomationId="{Binding Id, StringFormat='library-detail-clip-{0}-delete'}" ToolTipProperties.Text="{Binding Name, StringFormat='Delete {0} from your library.'}" Text="Delete" controls:Icon.Glyph="{x:Static models:IconFont.Delete}"
                                                Padding="14,6"
                                                TextColor="{DynamicResource SystemFillColorCritical}"
                                                Clicked="OnDeleteClicked" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <!-- Tile: compact grid, tap to play -->
                <CollectionView AutomationId="library-tiles" ItemsSource="{Binding Clips}"
                                 SelectionMode="None"
                                 IsVisible="{Binding ViewMode, Converter={StaticResource EnumEquals}, ConverterParameter=Tile}">
                    <CollectionView.EmptyView>
                        <Label AutomationId="library-tiles-empty"
                               Text="No audio clips yet. Import a file or record one in Audio Recorder."
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="10" VerticalItemSpacing="10" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:AudioClip">
                            <Border AutomationId="{Binding Id, StringFormat='library-tile-{0}'}" ToolTipProperties.Text="{Binding Name, StringFormat='Tap to play {0}. Double-tap to edit it.'}" StrokeShape="RoundRectangle 12" Padding="8" HeightRequest="120">
                                <Grid RowDefinitions="*,Auto" RowSpacing="4">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnPlayTapped" />
                                        <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnEditTapped" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Row="0" Style="{StaticResource IconTextBlockStyle}" Text="{x:Static models:IconFont.Music_note}" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                    <Label Style="{StaticResource CaptionTextBlockStyle}" Grid.Row="1" Text="{Binding Name}" HorizontalTextAlignment="Center"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </Grid>
        </RefreshView>

        <controls:TeachingPopover x:Name="LibraryTip" Grid.RowSpan="3" Target="{x:Reference ViewModes}" TipKey="library" Glyph="{x:Static models:IconFont.Lightbulb}"
                                  Title="Your clips"
                                  Message="Switch between the list, detail and tile views here. Play a clip with its play button, or tap a tile; edit it to trim, mix or change its sound. Import adds a file from your device." />
    </Grid>

</ContentPage>
