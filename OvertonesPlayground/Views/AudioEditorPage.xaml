<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="OvertonesPlayground.Views.AudioEditorPage" AutomationId="audioeditor-page" SafeAreaEdges="All"
             x:DataType="vm:AudioEditorViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Style="{StaticResource SubtitleTextBlockStyle}" AutomationId="audioeditor-clip-name" Text="{Binding LoadedClip.Name}" />

            <GraphicsView SemanticProperties.Description="Waveform of the clip being edited" AutomationId="audioeditor-waveform" x:Name="WaveformView" HeightRequest="160" BackgroundColor="{DynamicResource SolidBackgroundFillColorTertiary}" />

            <HorizontalStackLayout Spacing="12">
                <Button AutomationId="audioeditor-preview" Style="{StaticResource AccentButtonStyle}" Text="Preview" controls:Icon.Glyph="{x:Static models:IconFont.Play_arrow}" Command="{Binding PreviewCommand}" />
                <Button AutomationId="audioeditor-open-trim" Text="Open Trim Editor" controls:Icon.Glyph="{x:Static models:IconFont.Content_cut}" Command="{Binding OpenTrimEditorCommand}" />
            </HorizontalStackLayout>

            <toolkit:Expander IsExpanded="True">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-trim-header" Caption="Trim" Glyph="{x:Static models:IconFont.Content_cut}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider AutomationId="audioeditor-trim-start" LabelText="Start (s)" Minimum="0" Maximum="{Binding DurationSeconds}" Digits="2" Value="{Binding TrimStartSeconds}" />
                    <controls:LabeledSlider AutomationId="audioeditor-trim-end" LabelText="End (s)" Minimum="0" Maximum="{Binding DurationSeconds}" Digits="2" Value="{Binding TrimEndSeconds}" />
                    <Button AutomationId="audioeditor-trim-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply Trim" Command="{Binding TrimCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="True">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-gain-header" Caption="Gain" Glyph="{x:Static models:IconFont.Volume_up}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider AutomationId="audioeditor-gain" LabelText="Gain (dB)" Minimum="-24" Maximum="24" Digits="1" Value="{Binding GainDb}" />
                    <Button AutomationId="audioeditor-gain-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply Gain" Command="{Binding ApplyGainCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-fade-header" Caption="Fade In / Out" Glyph="{x:Static models:IconFont.Trending_down}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider AutomationId="audioeditor-fade-in" LabelText="Fade in" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeInSeconds}" />
                    <controls:LabeledSlider AutomationId="audioeditor-fade-out" LabelText="Fade out" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeOutSeconds}" />
                    <Button AutomationId="audioeditor-fade-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply Fade" Command="{Binding ApplyFadeCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-eq-header" Caption="Equalizer" Glyph="{x:Static models:IconFont.Tune}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider AutomationId="audioeditor-eq-low" LabelText="Low (dB)" Minimum="-12" Maximum="12" Digits="1" Value="{Binding EqLowGainDb}" />
                    <controls:LabeledSlider AutomationId="audioeditor-eq-mid" LabelText="Mid (dB)" Minimum="-12" Maximum="12" Digits="1" Value="{Binding EqMidGainDb}" />
                    <controls:LabeledSlider AutomationId="audioeditor-eq-high" LabelText="High (dB)" Minimum="-12" Maximum="12" Digits="1" Value="{Binding EqHighGainDb}" />
                    <Button AutomationId="audioeditor-eq-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply EQ" Command="{Binding ApplyEqualizerCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-compression-header" Caption="Compression" Glyph="{x:Static models:IconFont.Compress}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider AutomationId="audioeditor-compression-threshold" LabelText="Threshold (dB)" Minimum="-60" Maximum="0" Digits="1" Value="{Binding CompressionThresholdDb}" />
                    <controls:LabeledSlider AutomationId="audioeditor-compression-ratio" LabelText="Ratio" Minimum="1" Maximum="20" Digits="1" Value="{Binding CompressionRatio}" />
                    <controls:LabeledSlider AutomationId="audioeditor-compression-attack" LabelText="Attack (ms)" Minimum="1" Maximum="200" Digits="0" Value="{Binding CompressionAttackMs}" />
                    <controls:LabeledSlider AutomationId="audioeditor-compression-release" LabelText="Release (ms)" Minimum="10" Maximum="1000" Digits="0" Value="{Binding CompressionReleaseMs}" />
                    <Button AutomationId="audioeditor-compression-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply Compression" Command="{Binding ApplyCompressionCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-noise-header" Caption="Remove Noise" Glyph="{x:Static models:IconFont.Cleaning_services}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Uses the first stretch of the clip as its noise sample - trim to hum/hiss-only audio before running this for the best result." TextColor="{DynamicResource TextFillColorSecondary}" />
                    <controls:LabeledSlider AutomationId="audioeditor-noise-sample" LabelText="Noise sample (s)" Minimum="0.1" Maximum="5" Digits="2" Value="{Binding NoiseSampleSeconds}" />
                    <Button AutomationId="audioeditor-noise-apply" Style="{StaticResource AccentButtonStyle}" Text="Reduce Noise" Command="{Binding ReduceNoiseCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-vocals-header" Caption="Remove Vocals" Glyph="{x:Static models:IconFont.Mic_off}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Cancels audio that's identical in both channels - works best on true-stereo tracks with a centered vocal. Mono clips aren't supported." TextColor="{DynamicResource TextFillColorSecondary}" />
                    <Button AutomationId="audioeditor-vocals-apply" Style="{StaticResource AccentButtonStyle}" Text="Remove Vocals" Command="{Binding RemoveVocalsCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="audioeditor-voice-header" Caption="Voice Changer" Glyph="{x:Static models:IconFont.Record_voice_over}" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Shifts pitch by changing playback speed - like a record played at the wrong RPM. Duration changes along with pitch." TextColor="{DynamicResource TextFillColorSecondary}" />
                    <controls:LabeledSlider AutomationId="audioeditor-voice-pitch" LabelText="Pitch (semitones)" Minimum="-12" Maximum="12" Digits="1" Value="{Binding VoiceChangeSemitones}" />
                    <Button AutomationId="audioeditor-voice-apply" Style="{StaticResource AccentButtonStyle}" Text="Apply Voice Change" Command="{Binding ApplyVoiceChangeCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <BoxView HeightRequest="1" />

            <HorizontalStackLayout Spacing="12">
                <Button AutomationId="audioeditor-reverse" Text="Reverse" controls:Icon.Glyph="{x:Static models:IconFont.Fast_rewind}" Command="{Binding ReverseCommand}" />
                <Button AutomationId="audioeditor-normalize" Text="Normalize" controls:Icon.Glyph="{x:Static models:IconFont.Balance}" Command="{Binding NormalizeCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator AutomationId="audioeditor-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label AutomationId="audioeditor-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
