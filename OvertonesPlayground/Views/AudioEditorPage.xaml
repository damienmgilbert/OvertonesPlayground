<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.AudioEditorPage"
             x:DataType="vm:AudioEditorViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="{Binding LoadedClip.Name}" FontSize="22" FontAttributes="Bold" />

            <GraphicsView x:Name="WaveformView" HeightRequest="160" BackgroundColor="{StaticResource Gray950}" />

            <Button Text="Preview" Command="{Binding PreviewCommand}" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <Label Text="Trim" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="Start (s)" FontSize="12" />
                    <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding TrimStartSeconds}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="End (s)" FontSize="12" />
                    <Slider Minimum="0" Maximum="{Binding DurationSeconds}" Value="{Binding TrimEndSeconds}" />
                </VerticalStackLayout>
            </Grid>
            <Button Text="Apply Trim" Command="{Binding TrimCommand}" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <Label Text="Gain" FontAttributes="Bold" />
            <Slider Minimum="-24" Maximum="24" Value="{Binding GainDb}" />
            <Button Text="Apply Gain" Command="{Binding ApplyGainCommand}" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <Label Text="Fade In / Out (seconds)" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Slider Grid.Column="0" Minimum="0" Maximum="5" Value="{Binding FadeInSeconds}" />
                <Slider Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding FadeOutSeconds}" />
            </Grid>
            <Button Text="Apply Fade" Command="{Binding ApplyFadeCommand}" />

            <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Reverse" Command="{Binding ReverseCommand}" />
                <Button Text="Normalize" Command="{Binding NormalizeCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Gray500}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
