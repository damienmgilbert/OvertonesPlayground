<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="OvertonesPlayground.Views.AudioEditorPage"
             x:DataType="vm:AudioEditorViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="{Binding LoadedClip.Name}" FontSize="22" FontAttributes="Bold" />

            <GraphicsView x:Name="WaveformView" HeightRequest="160" BackgroundColor="{StaticResource Gray950}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="▶ Preview" Command="{Binding PreviewCommand}" />
                <Button Text="✂ Open Trim Editor" Command="{Binding OpenTrimEditorCommand}" />
            </HorizontalStackLayout>

            <toolkit:Expander IsExpanded="True">
                <toolkit:Expander.Header>
                    <Label Text="✂ Trim" FontAttributes="Bold" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider LabelText="Start (s)" Minimum="0" Maximum="{Binding DurationSeconds}" Digits="2" Value="{Binding TrimStartSeconds}" />
                    <controls:LabeledSlider LabelText="End (s)" Minimum="0" Maximum="{Binding DurationSeconds}" Digits="2" Value="{Binding TrimEndSeconds}" />
                    <Button Text="Apply Trim" Command="{Binding TrimCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="True">
                <toolkit:Expander.Header>
                    <Label Text="🔊 Gain" FontAttributes="Bold" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider LabelText="Gain (dB)" Minimum="-24" Maximum="24" Digits="1" Value="{Binding GainDb}" />
                    <Button Text="Apply Gain" Command="{Binding ApplyGainCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <toolkit:Expander IsExpanded="False">
                <toolkit:Expander.Header>
                    <Label Text="📉 Fade In / Out" FontAttributes="Bold" Padding="0,10" />
                </toolkit:Expander.Header>
                <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                    <controls:LabeledSlider LabelText="Fade in" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeInSeconds}" />
                    <controls:LabeledSlider LabelText="Fade out" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeOutSeconds}" />
                    <Button Text="Apply Fade" Command="{Binding ApplyFadeCommand}" />
                </VerticalStackLayout>
            </toolkit:Expander>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource CardStrokeDark}}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="⏪ Reverse" Command="{Binding ReverseCommand}" />
                <Button Text="⚖ Normalize" Command="{Binding NormalizeCommand}" />
            </HorizontalStackLayout>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Gray500}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
