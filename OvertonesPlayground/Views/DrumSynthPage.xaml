<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
             x:Class="OvertonesPlayground.Views.DrumSynthPage" AutomationId="drumsynth-page" SafeAreaEdges="All"
             x:DataType="vm:DrumSynthViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <controls:IconLabel Style="{StaticResource SubtitleTextBlockStyle}" Caption="Drum &amp; Bass Synth" Glyph="{x:Static models:IconFont.Graphic_eq}" />
            <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Pick a type to load its defaults, tune every knob, Generate &amp; Play to preview, then Save to keep it in your library (and your device's Music folder) for the Launchpad and Mixer."
                   TextColor="{DynamicResource TextFillColorSecondary}" />

            <CollectionView AutomationId="drumsynth-types" ItemsSource="{Binding DrumOptions}" HeightRequest="150">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="5" HorizontalItemSpacing="8" VerticalItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:DrumType">
                        <Button AutomationId="{Binding ., StringFormat='drumsynth-type-{0}'}" ToolTipProperties.Text="{Binding ., StringFormat='Load the default settings for {0}.'}" Text="{Binding .}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:DrumSynthViewModel}}, Path=SelectDrumCommand}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <GraphicsView SemanticProperties.Description="Waveform preview of the generated drum sound" AutomationId="drumsynth-waveform" x:Name="WaveformView" HeightRequest="120" BackgroundColor="{DynamicResource SolidBackgroundFillColorTertiary}" />

            <VerticalStackLayout BindingContext="{Binding SelectedDrumParams}"
                                  x:DataType="vm:DrumSynthParametersViewModel"
                                  Spacing="12">

                <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="drumsynth-editing" Caption="{Binding DrumType, StringFormat='Editing: {0}'}" Glyph="{x:Static models:IconFont.Tune}" TextColor="{DynamicResource AccentTextFillColorPrimary}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="12">
                    <Label Grid.Row="0" Grid.Column="0" Text="Sample rate" VerticalOptions="Center" />
                    <Picker AutomationId="drumsynth-sample-rate" ToolTipProperties.Text="Samples per second of the generated sound. Higher is cleaner but makes bigger files." Grid.Row="0" Grid.Column="1"
                            ItemsSource="{x:Static vm:DrumSynthParametersViewModel.SampleRateOptions}"
                            SelectedItem="{Binding SampleRate}" />
                </Grid>

                <controls:LabeledSlider AutomationId="drumsynth-duration" LabelText="Duration" Minimum="0.02" Maximum="2" Digits="3" Value="{Binding DurationSeconds}" />
                <controls:LabeledSlider AutomationId="drumsynth-level" LabelText="Level" Minimum="0" Maximum="1" Digits="2" Value="{Binding Amplitude}" />
                <controls:LabeledSlider AutomationId="drumsynth-decay" LabelText="Decay" Minimum="0.5" Maximum="60" Digits="1" Value="{Binding DecayRate}" />

                <toolkit:Expander IsVisible="{Binding ShowPitchSweep}" IsExpanded="True">
                    <toolkit:Expander.Header>
                        <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="drumsynth-pitch-sweep-header" Caption="Pitch Sweep" Glyph="{x:Static models:IconFont.Trending_up}" Padding="0,10" />
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                        <controls:LabeledSlider AutomationId="drumsynth-sweep-start" LabelText="Start" Minimum="20" Maximum="2000" Digits="0" Value="{Binding StartFrequencyHz}" />
                        <controls:LabeledSlider AutomationId="drumsynth-sweep-end" LabelText="End" Minimum="20" Maximum="2000" Digits="0" Value="{Binding EndFrequencyHz}" />
                        <controls:LabeledSlider AutomationId="drumsynth-sweep-rate" LabelText="Sweep" Minimum="1" Maximum="60" Digits="1" Value="{Binding SweepRate}" />
                    </VerticalStackLayout>
                </toolkit:Expander>

                <toolkit:Expander IsVisible="{Binding ShowSnareControls}" IsExpanded="True">
                    <toolkit:Expander.Header>
                        <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="drumsynth-snare-header" Caption="Snare Body" Glyph="{x:Static models:IconFont.Music_note}" Padding="0,10" />
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                        <controls:LabeledSlider AutomationId="drumsynth-snare-tone" LabelText="Tone" Minimum="50" Maximum="1000" Digits="0" Value="{Binding ToneFrequencyHz}" />
                        <controls:LabeledSlider AutomationId="drumsynth-snare-tone-decay" LabelText="Tone decay" Minimum="0.5" Maximum="80" Digits="1" Value="{Binding ToneDecayRate}" />
                        <controls:LabeledSlider AutomationId="drumsynth-snare-tone-level" LabelText="Tone level" Minimum="0" Maximum="1" Digits="2" Value="{Binding ToneLevel}" />
                        <controls:LabeledSlider AutomationId="drumsynth-snare-noise-level" LabelText="Noise level" Minimum="0" Maximum="1" Digits="2" Value="{Binding NoiseLevel}" />
                    </VerticalStackLayout>
                </toolkit:Expander>

                <toolkit:Expander IsVisible="{Binding ShowClapControls}" IsExpanded="True">
                    <toolkit:Expander.Header>
                        <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="drumsynth-clap-header" Caption="Clap Bursts" Glyph="{x:Static models:IconFont.Waving_hand}" Padding="0,10" />
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14">
                            <Label Grid.Column="0" Text="Burst count" VerticalOptions="Center" />
                            <Stepper AutomationId="drumsynth-clap-burst-count" ToolTipProperties.Text="How many quick claps make up the clap sound." Grid.Column="1" Minimum="1" Maximum="8" Increment="1" Value="{Binding BurstCount}" HorizontalOptions="Start" />
                            <Label AutomationId="drumsynth-clap-burst-count-text" Grid.Column="2" Text="{Binding BurstCount}" VerticalOptions="Center" />
                        </Grid>
                        <controls:LabeledSlider AutomationId="drumsynth-clap-spacing" LabelText="Spacing" Minimum="0" Maximum="0.05" Digits="3" Value="{Binding BurstSpacingSeconds}" />
                    </VerticalStackLayout>
                </toolkit:Expander>

                <toolkit:Expander IsExpanded="False">
                    <toolkit:Expander.Header>
                        <controls:IconLabel Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="drumsynth-filter-header" Caption="Filter" Glyph="{x:Static models:IconFont.Filter_alt}" Padding="0,10" />
                    </toolkit:Expander.Header>
                    <VerticalStackLayout Spacing="12" Padding="0,4,0,12">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="12">
                            <Label Grid.Row="0" Grid.Column="0" Text="Type" VerticalOptions="Center" />
                            <Picker AutomationId="drumsynth-filter-type" ToolTipProperties.Text="Which frequencies the filter lets through." Grid.Row="0" Grid.Column="1"
                                    ItemsSource="{x:Static vm:DrumSynthParametersViewModel.FilterOptions}"
                                    SelectedItem="{Binding FilterType}" />
                        </Grid>
                        <controls:LabeledSlider AutomationId="drumsynth-filter-cutoff" LabelText="Cutoff" Minimum="100" Maximum="15000" Digits="0" Value="{Binding FilterCutoffHz}" />
                        <controls:LabeledSlider AutomationId="drumsynth-filter-resonance" LabelText="Resonance" Minimum="0.1" Maximum="5" Digits="2" Value="{Binding FilterResonance}" />
                    </VerticalStackLayout>
                </toolkit:Expander>
            </VerticalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Button AutomationId="drumsynth-generate" ToolTipProperties.Text="Make the sound with these settings and play it." Style="{StaticResource AccentButtonStyle}" Text="Generate &amp; Play" controls:Icon.Glyph="{x:Static models:IconFont.Play_arrow}" Command="{Binding GenerateCommand}" />
                <Button AutomationId="drumsynth-save" ToolTipProperties.Text="Save the sound to your library." Style="{StaticResource AccentButtonStyle}" Text="Save" controls:Icon.Glyph="{x:Static models:IconFont.Save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            </HorizontalStackLayout>

            <ActivityIndicator AutomationId="drumsynth-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label AutomationId="drumsynth-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
