<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.SoundCreatorPage" AutomationId="soundcreator-page" SafeAreaEdges="All"
             x:DataType="vm:SoundCreatorViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="40" Spacing="20" VerticalOptions="Center" MaximumWidthRequest="600" HorizontalOptions="Center">

        <controls:IconLabel Style="{StaticResource SubtitleTextBlockStyle}" Caption="Audio Recorder" Glyph="{x:Static models:IconFont.Mic}" HorizontalTextAlignment="Center" />
        <Label Text="Record a new sample to use in the Launchpad, Mixer, or Editor." HorizontalTextAlignment="Center" TextColor="{DynamicResource TextFillColorSecondary}" />

        <Entry AutomationId="soundcreator-name" ToolTipProperties.Text="The name the recording is saved under." Placeholder="Recording name" Text="{Binding NewClipName}" IsEnabled="{Binding IsRecording, Converter={StaticResource InvertedBool}}" />

        <Label Style="{StaticResource TitleLargeTextBlockStyle}" AutomationId="soundcreator-elapsed" Text="{Binding ElapsedText}" HorizontalTextAlignment="Center" />

<Button x:Name="RecordButton" AutomationId="soundcreator-record" ToolTipProperties.Text="Start recording from the microphone, or stop and save the recording." Style="{StaticResource AccentButtonStyle}" Text="{Binding IsRecording, Converter={StaticResource RecordButtonLabel}}"
                controls:Icon.Glyph="{x:Static models:IconFont.Radio_button_checked}" controls:Icon.Size="24"
                HeightRequest="70"
                Command="{Binding ToggleRecordingCommand}">
            <Button.Triggers>
                <DataTrigger TargetType="Button" Binding="{Binding IsRecording}" Value="True">
                    <Setter Property="controls:Icon.Glyph" Value="{x:Static models:IconFont.Stop}" />
                    <Setter Property="BackgroundColor" Value="{DynamicResource SystemFillColorCritical}" />
                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                    <Setter Property="BorderColor" Value="{DynamicResource SystemFillColorCritical}" />
                </DataTrigger>
            </Button.Triggers>
        </Button>

        <Button AutomationId="soundcreator-cancel" ToolTipProperties.Text="Stop and throw away this recording." Text="Cancel Recording" controls:Icon.Glyph="{x:Static models:IconFont.Close}"
                IsVisible="{Binding IsRecording}"
                Command="{Binding CancelRecordingCommand}" />

        <Label AutomationId="soundcreator-status" Text="{Binding StatusMessage}" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextFillColorSecondary}" />

    </VerticalStackLayout>

</ContentPage>
