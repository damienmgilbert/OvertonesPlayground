<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.PlayerPage" AutomationId="player-page" SafeAreaEdges="All"
             x:DataType="vm:PlayerViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="40">
            <Label Text="🎵" FontSize="88" HorizontalTextAlignment="Center" TextColor="{StaticResource Gray300}" />
            <Label AutomationId="player-clip-name" Text="{Binding ClipName}" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" StrokeShape="Rectangle"
                Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource CardStrokeDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource CardBackgroundDark}}">
            <VerticalStackLayout Padding="24,18" Spacing="14">

                <Slider AutomationId="player-position-slider" x:Name="PositionSlider"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        DragCompleted="OnSeekCompleted" />

                <Grid ColumnDefinitions="*,*">
                    <Label AutomationId="player-position-text" Grid.Column="0" Text="{Binding PositionText}" FontSize="12" TextColor="{StaticResource Gray500}" />
                    <Label AutomationId="player-duration-text" Grid.Column="1" Text="{Binding DurationText}" FontSize="12" TextColor="{StaticResource Gray500}" HorizontalTextAlignment="End" />
                </Grid>

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button AutomationId="player-play-pause" Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}"
                            FontSize="28"
                            WidthRequest="90"
                            HeightRequest="90"
                            CornerRadius="45"
                            Command="{Binding PlayPauseCommand}" />
                    <Button AutomationId="player-stop" Text="⏹" FontSize="24" WidthRequest="70" HeightRequest="70" CornerRadius="35"
                            VerticalOptions="Center"
                            Command="{Binding StopCommand}" />
                </HorizontalStackLayout>

                <controls:LabeledSlider AutomationId="player-volume" LabelText="Volume" Minimum="0" Maximum="1" Digits="2" Value="{Binding Volume}" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
