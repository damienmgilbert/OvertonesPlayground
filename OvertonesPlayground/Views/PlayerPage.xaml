<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.PlayerPage"
             x:DataType="vm:PlayerViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="40" Spacing="24" VerticalOptions="Center" MaximumWidthRequest="700" HorizontalOptions="Center">

        <Label Text="{Binding ClipName}" FontSize="26" FontAttributes="Bold" HorizontalTextAlignment="Center" />

        <Slider x:Name="PositionSlider"
                Minimum="0"
                Maximum="{Binding DurationSeconds}"
                Value="{Binding PositionSeconds, Mode=OneWay}"
                DragCompleted="OnSeekCompleted" />

        <Grid ColumnDefinitions="*,*">
            <Label Grid.Column="0" Text="{Binding PositionText}" />
            <Label Grid.Column="1" Text="{Binding DurationText}" HorizontalTextAlignment="End" />
        </Grid>

        <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
            <Button Text="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}"
                    FontSize="28"
                    WidthRequest="90"
                    HeightRequest="90"
                    CornerRadius="45"
                    Command="{Binding PlayPauseCommand}" />
            <Button Text="⏹" FontSize="24" WidthRequest="70" HeightRequest="70" CornerRadius="35"
                    Command="{Binding StopCommand}" />
        </HorizontalStackLayout>

        <VerticalStackLayout Spacing="6">
            <Label Text="Volume" />
            <Slider Minimum="0" Maximum="1" Value="{Binding Volume}" />
        </VerticalStackLayout>

    </VerticalStackLayout>

</ContentPage>
