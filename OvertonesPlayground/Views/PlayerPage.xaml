<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.PlayerPage" AutomationId="player-page" SafeAreaEdges="All"
             x:DataType="vm:PlayerViewModel"
             Title="{Binding Title}">

    <Grid RowDefinitions="*,Auto">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="16" Padding="40">
            <Label Style="{StaticResource IconTextBlockStyle}" Text="{x:Static models:IconFont.Music_note}" FontSize="88" HorizontalTextAlignment="Center" TextColor="{DynamicResource TextFillColorTertiary}" />
            <Label Style="{StaticResource TitleTextBlockStyle}" AutomationId="player-clip-name" Text="{Binding ClipName}" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Border Grid.Row="1" StrokeShape="Rectangle">
            <VerticalStackLayout Padding="24,18" Spacing="14">

                <Slider AutomationId="player-position-slider" ToolTipProperties.Text="Drag to jump to another point in the clip." x:Name="PositionSlider"
                        Minimum="0"
                        Maximum="{Binding DurationSeconds}"
                        Value="{Binding PositionSeconds, Mode=OneWay}"
                        DragCompleted="OnSeekCompleted" />

                <Grid ColumnDefinitions="*,*">
                    <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="player-position-text" Grid.Column="0" Text="{Binding PositionText}" TextColor="{DynamicResource TextFillColorSecondary}" />
                    <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="player-duration-text" Grid.Column="1" Text="{Binding DurationText}" TextColor="{DynamicResource TextFillColorSecondary}" HorizontalTextAlignment="End" />
                </Grid>

                <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                    <Button AutomationId="player-play-pause" Style="{StaticResource AccentButtonStyle}" Shadow="{DynamicResource CardShadow}" controls:Icon.Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" controls:Icon.Size="40" SemanticProperties.Description="{Binding IsPlaying, Converter={StaticResource PlayPauseLabel}}"
                            WidthRequest="90"
                            HeightRequest="90"
                            CornerRadius="45"
                            Command="{Binding PlayPauseCommand}" />
                    <Button AutomationId="player-stop" Shadow="{DynamicResource CardShadow}" controls:Icon.Glyph="{x:Static models:IconFont.Stop}" controls:Icon.Size="32" SemanticProperties.Description="Stop" WidthRequest="70" HeightRequest="70" CornerRadius="35"
                            VerticalOptions="Center"
                            Command="{Binding StopCommand}" />
                </HorizontalStackLayout>

                <controls:LabeledSlider AutomationId="player-volume" LabelText="Volume" Minimum="0" Maximum="1" Digits="2" Value="{Binding Volume}" />

            </VerticalStackLayout>
        </Border>

    </Grid>

</ContentPage>
