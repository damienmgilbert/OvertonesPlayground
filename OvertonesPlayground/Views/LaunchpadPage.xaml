<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.LaunchpadPage" AutomationId="launchpad-page"
             x:DataType="vm:LaunchpadViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="launchpad-edit" Text="{Binding EditModeText}" Command="{Binding ToggleEditModeCommand}" />
        <ToolbarItem AutomationId="launchpad-stop-all" Text="⏹ Stop All" Command="{Binding StopAllCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*" Margin="12" RowSpacing="8">
    <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="launchpad-hint" Grid.Row="0" TextColor="{DynamicResource TextFillColorSecondary}"
           Text="{Binding HintText}" />
    <CollectionView AutomationId="launchpad-pads" Grid.Row="1" ItemsSource="{Binding Pads}">
        <CollectionView.ItemsLayout>
            <GridItemsLayout Orientation="Vertical" Span="8" HorizontalItemSpacing="6" VerticalItemSpacing="6" />
        </CollectionView.ItemsLayout>
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="vm:LaunchpadPadViewModel">
                <!-- Long-press opens the pad menu (assign / loop / stop / clear): the alternative to the double- and triple-tap
                     gestures. LongPressBorder is used because a behavior declared in a template gets no binding context. -->
                <controls:LongPressBorder AutomationId="{Binding Index, StringFormat='launchpad-pad-{0}'}" StrokeShape="RoundRectangle 8" LongPressed="OnPadLongPressed"
                        SemanticProperties.Description="{Binding AccessibleName}"
                        SemanticProperties.Hint="Plays this pad. Long-press, or turn on edit mode, for more options"
                        BackgroundColor="{DynamicResource CardBackgroundFillColorDefault}"
                        Stroke="{DynamicResource CardStrokeColorDefaultBrush}"
                        StrokeThickness="1"
                        HeightRequest="90">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LaunchpadViewModel}}, Path=TriggerCommand}"
                            CommandParameter="{Binding .}" />
                        <TapGestureRecognizer NumberOfTapsRequired="2"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LaunchpadViewModel}}, Path=AssignCommand}"
                            CommandParameter="{Binding .}" />
                        <TapGestureRecognizer NumberOfTapsRequired="3"
                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:LaunchpadViewModel}}, Path=ToggleLoopCommand}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <Grid>
                        <!-- A filled pad is drawn in its sample's palette color, over the card. Empty pads show just the card, so
                             they follow the light/dark theme; the color is a data value and stays the same in both themes. -->
                        <BoxView Color="{Binding ColorHex, Converter={StaticResource HexColor}}" IsVisible="{Binding HasClip}" />
                        <Grid RowDefinitions="*,Auto" Padding="6">
                            <!-- Text on the palette color is white; on the empty card it takes the theme's text colors. -->
                            <Label Grid.Row="0"
                                   Text="{Binding Label}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   TextColor="{DynamicResource TextFillColorSecondary}"
                                   VerticalOptions="Center"
                                   HorizontalOptions="Center"
                                   LineBreakMode="TailTruncation">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasClip}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                            <Label Grid.Row="1"
                                   Text="loop"
                                   FontSize="10"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   IsVisible="{Binding IsLooping}" />
                            <!-- Edit-mode badge: a plain tap opens the pad menu instead of playing the pad. -->
                            <Label Grid.Row="0"
                                   Text="✎"
                                   FontSize="16"
                                   TextColor="{DynamicResource TextFillColorPrimary}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:LaunchpadViewModel}}, Path=IsEditMode}">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label" Binding="{Binding HasClip}" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Grid>
                    </Grid>
                </controls:LongPressBorder>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
    </Grid>

</ContentPage>
