<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.TrimPage" AutomationId="trim-page" SafeAreaEdges="All"
             x:DataType="vm:TrimViewModel"
             Title="{Binding Title}">

    <ContentPage.ToolbarItems>
        <ToolbarItem AutomationId="trim-undo" Text="Undo" controls:Icon.Glyph="{x:Static models:IconFont.Undo}" controls:Icon.Size="24" Command="{Binding UndoCommand}" />
        <ToolbarItem AutomationId="trim-redo" Text="Redo" controls:Icon.Glyph="{x:Static models:IconFont.Redo}" controls:Icon.Size="24" Command="{Binding RedoCommand}" />
        <ToolbarItem AutomationId="trim-save" Text="Save" controls:Icon.Glyph="{x:Static models:IconFont.Save}" controls:Icon.Size="24" Command="{Binding SaveCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" Padding="16,12" RowSpacing="12">

        <Label Style="{StaticResource SubtitleTextBlockStyle}" AutomationId="trim-clip-name" Grid.Row="0" Text="{Binding LoadedClip.Name}" LineBreakMode="TailTruncation" />

        <!-- Start/end time steppers, with the total duration centered between them. Tap a time to type an exact value. -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
            <HorizontalStackLayout Grid.Column="0" Spacing="4" HorizontalOptions="Start">
                <Button AutomationId="trim-start-decrease" controls:Icon.Glyph="{x:Static models:IconFont.Remove}" controls:Icon.Size="22" SemanticProperties.Description="Decrease start time" Padding="12,6" Command="{Binding DecreaseStartCommand}" />
                <Label Style="{StaticResource BodyStrongTextBlockStyle}" SemanticProperties.Hint="Enter an exact start time" AutomationId="trim-start-time" ToolTipProperties.Text="Tap to type an exact start time." Text="{Binding StartTimeText}" VerticalOptions="Center" MinimumWidthRequest="60" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnStartTimeTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Button AutomationId="trim-start-increase" controls:Icon.Glyph="{x:Static models:IconFont.Add}" controls:Icon.Size="22" SemanticProperties.Description="Increase start time" Padding="12,6" Command="{Binding IncreaseStartCommand}" />
            </HorizontalStackLayout>

            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Total" TextColor="{DynamicResource TextFillColorSecondary}" HorizontalTextAlignment="Center" />
                <Label Style="{StaticResource BodyStrongTextBlockStyle}" AutomationId="trim-total-time" Text="{Binding TotalTimeText}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="2" Spacing="4" HorizontalOptions="End">
                <Button AutomationId="trim-end-decrease" controls:Icon.Glyph="{x:Static models:IconFont.Remove}" controls:Icon.Size="22" SemanticProperties.Description="Decrease end time" Padding="12,6" Command="{Binding DecreaseEndCommand}" />
                <Label Style="{StaticResource BodyStrongTextBlockStyle}" SemanticProperties.Hint="Enter an exact end time" AutomationId="trim-end-time" ToolTipProperties.Text="Tap to type an exact end time." Text="{Binding EndTimeText}" VerticalOptions="Center" MinimumWidthRequest="60" HorizontalTextAlignment="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEndTimeTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Button AutomationId="trim-end-increase" controls:Icon.Glyph="{x:Static models:IconFont.Add}" controls:Icon.Size="22" SemanticProperties.Description="Increase end time" Padding="12,6" Command="{Binding IncreaseEndCommand}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Waveform, with draggable start/end handles and a scrub-to-seek gesture -->
        <Grid AutomationId="trim-waveform" ToolTipProperties.Text="Tap to move the playhead." Grid.Row="2" x:Name="WaveformContainer" SizeChanged="OnWaveformContainerSizeChanged" VerticalOptions="Center" IsClippedToBounds="True" Padding="24,0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnWaveformTapped" />
            </Grid.GestureRecognizers>

            <GraphicsView SemanticProperties.Description="Waveform of the clip. The part that Save keeps is highlighted" SemanticProperties.Hint="Tap to move the playhead" x:Name="WaveformView" HeightRequest="240" BackgroundColor="{DynamicResource SolidBackgroundFillColorTertiary}" />

            <BoxView WidthRequest="2" Color="{DynamicResource AccentFillColorDefault}" HorizontalOptions="Start" VerticalOptions="Fill" HeightRequest="240"
                     Margin="-1,0,0,0" TranslationX="{Binding StartHandleX}" InputTransparent="True" />
            <!-- A 48dp touch target (the recommended minimum) around the 32dp visual, so the handle is easy to grab. The
                 gesture, id and semantics sit on the target; the margin is half of 48 so the center stays on the trim point. -->
            <Grid x:Name="StartHandle" SemanticProperties.Description="Trim start handle" SemanticProperties.Hint="Drag to move the start. The minus and plus buttons do the same" AutomationId="trim-start-handle" ToolTipProperties.Text="Drag to move where the kept part starts." WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent"
                  HorizontalOptions="Start" VerticalOptions="Center" Margin="-24,0,0,0" TranslationX="{Binding StartHandleX}">
                <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{DynamicResource AccentFillColorDefault}"
                        HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Label Style="{StaticResource IconTextBlockStyle}" Text="{x:Static models:IconFont.Chevron_left}" TextColor="{DynamicResource TextOnAccentFillColorPrimary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" InputTransparent="True" />
                </Border>
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnStartHandlePanUpdated" />
                </Grid.GestureRecognizers>
            </Grid>

            <BoxView WidthRequest="2" Color="{DynamicResource AccentFillColorDefault}" HorizontalOptions="Start" VerticalOptions="Fill" HeightRequest="240"
                     Margin="-1,0,0,0" TranslationX="{Binding EndHandleX}" InputTransparent="True" />
            <!-- A 48dp touch target (the recommended minimum) around the 32dp visual, so the handle is easy to grab. The
                 gesture, id and semantics sit on the target; the margin is half of 48 so the center stays on the trim point. -->
            <Grid SemanticProperties.Description="Trim end handle" SemanticProperties.Hint="Drag to move the end. The minus and plus buttons do the same" AutomationId="trim-end-handle" ToolTipProperties.Text="Drag to move where the kept part ends." WidthRequest="48" HeightRequest="48" BackgroundColor="Transparent"
                  HorizontalOptions="Start" VerticalOptions="Center" Margin="-24,0,0,0" TranslationX="{Binding EndHandleX}">
                <Border WidthRequest="32" HeightRequest="32" StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{DynamicResource AccentFillColorDefault}"
                        HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True">
                    <Label Style="{StaticResource IconTextBlockStyle}" Text="{x:Static models:IconFont.Chevron_right}" TextColor="{DynamicResource TextOnAccentFillColorPrimary}" FontSize="20" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" InputTransparent="True" />
                </Border>
                <Grid.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnEndHandlePanUpdated" />
                </Grid.GestureRecognizers>
            </Grid>
        </Grid>

        <!-- Trim mode toggle + zoom/pan controls -->
        <Grid Grid.Row="3" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <HorizontalStackLayout Grid.Column="0" Spacing="10" HorizontalOptions="Start">
                <Button AutomationId="trim-mode-trim" ToolTipProperties.Text="Keep only the part between the handles." Style="{StaticResource AccentButtonStyle}" Text="Trim" controls:Icon.Glyph="{x:Static models:IconFont.Content_cut}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:TrimMode.Trim}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Mode}" Value="{x:Static models:TrimMode.TrimMiddle}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorDefault}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
                <Button AutomationId="trim-mode-trim-middle" ToolTipProperties.Text="Cut out the part between the handles and join the rest together." Style="{StaticResource AccentButtonStyle}" Text="Trim Middle" controls:Icon.Glyph="{x:Static models:IconFont.Content_cut}" Command="{Binding SetModeCommand}" CommandParameter="{x:Static models:TrimMode.TrimMiddle}">
                    <Button.Triggers>
                        <DataTrigger TargetType="Button" Binding="{Binding Mode}" Value="{x:Static models:TrimMode.Trim}">
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorDefault}" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                <Button AutomationId="trim-pan-earlier" controls:Icon.Glyph="{x:Static models:IconFont.Chevron_left}" controls:Icon.Size="22" SemanticProperties.Description="Pan the waveform earlier" Padding="10,6" Command="{Binding PanEarlierCommand}" IsVisible="{Binding IsZoomed}" />
                <Button AutomationId="trim-zoom-out" controls:Icon.Glyph="{x:Static models:IconFont.Remove}" controls:Icon.Size="22" SemanticProperties.Description="Zoom out" Padding="10,6" Command="{Binding ZoomOutCommand}" />
                <Label Style="{StaticResource CaptionTextBlockStyle}" AutomationId="trim-zoom-level" Text="{Binding ZoomLevelText}" VerticalOptions="Center" MinimumWidthRequest="30" HorizontalTextAlignment="Center" />
                <Button AutomationId="trim-zoom-in" controls:Icon.Glyph="{x:Static models:IconFont.Add}" controls:Icon.Size="22" SemanticProperties.Description="Zoom in" Padding="10,6" Command="{Binding ZoomInCommand}" />
                <Button AutomationId="trim-pan-later" controls:Icon.Glyph="{x:Static models:IconFont.Chevron_right}" controls:Icon.Size="22" SemanticProperties.Description="Pan the waveform later" Padding="10,6" Command="{Binding PanLaterCommand}" IsVisible="{Binding IsZoomed}" />
            </HorizontalStackLayout>
        </Grid>

        <!-- Split / insert at playhead -->
        <HorizontalStackLayout Grid.Row="4" Spacing="10" HorizontalOptions="Center">
            <Button AutomationId="trim-split" ToolTipProperties.Text="Cut the clip in two at the playhead." Text="Split at Playhead" controls:Icon.Glyph="{x:Static models:IconFont.Content_cut}" Command="{Binding SplitAtPlayheadCommand}" />
            <Button AutomationId="trim-insert-clip" ToolTipProperties.Text="Insert another clip at the playhead." Text="Insert Clip Here" controls:Icon.Glyph="{x:Static models:IconFont.Attach_file}" Clicked="OnInsertClipClicked" />
        </HorizontalStackLayout>

        <!-- Playback transport + bottom quick-action bar -->
        <VerticalStackLayout Grid.Row="5" Spacing="12">

            <HorizontalStackLayout Spacing="20" HorizontalOptions="Center">
                <Button AutomationId="trim-skip-start" controls:Icon.Glyph="{x:Static models:IconFont.Skip_previous}" controls:Icon.Size="24" SemanticProperties.Description="Skip to start" Command="{Binding SkipToStartCommand}" WidthRequest="52" HeightRequest="52" CornerRadius="26" />
                <Button AutomationId="trim-play-pause" Style="{StaticResource AccentButtonStyle}" Shadow="{DynamicResource CardShadow}" controls:Icon.Glyph="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" controls:Icon.Size="32" SemanticProperties.Description="{Binding IsPlaying, Converter={StaticResource PlayPauseLabel}}" Command="{Binding PlayPauseCommand}"
                        WidthRequest="72" HeightRequest="72" CornerRadius="36" />
                <Button AutomationId="trim-skip-end" controls:Icon.Glyph="{x:Static models:IconFont.Skip_next}" controls:Icon.Size="24" SemanticProperties.Description="Skip to end" Command="{Binding SkipToEndCommand}" WidthRequest="52" HeightRequest="52" CornerRadius="26" />
            </HorizontalStackLayout>

            <Border StrokeShape="Rectangle">
                <VerticalStackLayout Padding="16,12" Spacing="10">

                    <HorizontalStackLayout Spacing="16" HorizontalOptions="Center">
                        <Button AutomationId="trim-tool-volume" ToolTipProperties.Text="Change the volume of the kept part." Text="Volume" controls:Icon.Glyph="{x:Static models:IconFont.Volume_up}" Padding="12,8" Command="{Binding ToggleToolCommand}" CommandParameter="{x:Static models:TrimTool.Volume}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="{x:Static models:TrimTool.Volume}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button AutomationId="trim-tool-fade-in" ToolTipProperties.Text="Fade the start of the kept part in." Text="Fade In" controls:Icon.Glyph="{x:Static models:IconFont.Trending_up}" Padding="12,8" Command="{Binding ToggleToolCommand}" CommandParameter="{x:Static models:TrimTool.FadeIn}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="{x:Static models:TrimTool.FadeIn}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button AutomationId="trim-tool-fade-out" ToolTipProperties.Text="Fade the end of the kept part out." Text="Fade Out" controls:Icon.Glyph="{x:Static models:IconFont.Trending_down}" Padding="12,8" Command="{Binding ToggleToolCommand}" CommandParameter="{x:Static models:TrimTool.FadeOut}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="{x:Static models:TrimTool.FadeOut}">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
                                    <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                                    <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </HorizontalStackLayout>

                    <controls:LabeledSlider AutomationId="trim-gain" IsVisible="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=Volume}"
                                             LabelText="Volume (dB)" Minimum="-24" Maximum="24" Digits="1" Value="{Binding GainDb}" />
                    <controls:LabeledSlider AutomationId="trim-fade-in" IsVisible="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=FadeIn}"
                                             LabelText="Fade in (s)" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeInSeconds}" />
                    <controls:LabeledSlider AutomationId="trim-fade-out" IsVisible="{Binding ActiveTool, Converter={StaticResource EnumEquals}, ConverterParameter=FadeOut}"
                                             LabelText="Fade out (s)" Minimum="0" Maximum="5" Digits="2" Value="{Binding FadeOutSeconds}" />

                    <ActivityIndicator AutomationId="trim-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                    <Label AutomationId="trim-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" IsVisible="{Binding StatusMessage, Converter={StaticResource StringToBool}}" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>

        <controls:TeachingPopover x:Name="TrimTip" Grid.RowSpan="6" Target="{x:Reference StartHandle}" TipKey="trim" Glyph="{x:Static models:IconFont.Lightbulb}"
                                  Title="Choose what to keep"
                                  Message="Drag the round handles along the waveform. For an exact cut, tap a time to type it, or nudge it with the minus and plus buttons. Undo and Redo are in the top bar." />
    </Grid>

</ContentPage>
