<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="600">

        <Grid ColumnDefinitions="Auto,*">
            <Label Grid.Column="0" Text="🎨 Theme" VerticalOptions="Center" />
            <Picker Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Keep screen on while using OvertonesPlayground" VerticalOptions="Center" />
            <Switch Grid.Column="1" IsToggled="{Binding KeepScreenOn}" />
        </Grid>

        <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

        <Button Text="⏹ Stop All Audio" Command="{Binding StopAllAudioCommand}" />

        <Button Text="🗑 Clear Library" BackgroundColor="{StaticResource Gray600}" Command="{Binding ClearLibraryCommand}" />

        <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Gray500}" />

        <BoxView HeightRequest="1" Color="{StaticResource Gray300}" />

        <Label Text="{Binding AppVersion, StringFormat='OvertonesPlayground v{0}'}" TextColor="{StaticResource Gray500}" />

    </VerticalStackLayout>

</ContentPage>
