<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             x:Class="OvertonesPlayground.Views.SettingsPage" AutomationId="settings-page"
             x:DataType="vm:SettingsViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="20" MaximumWidthRequest="600">

        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <controls:IconLabel Style="{StaticResource BodyTextBlockStyle}" Grid.Column="0" Caption="Theme" Glyph="{x:Static models:IconFont.Palette}" VerticalOptions="Center" />
            <Picker AutomationId="settings-theme" ToolTipProperties.Text="Choose the light or dark look, or follow the device setting." Grid.Column="1" ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding SelectedTheme}" />
        </Grid>

        <Grid ColumnDefinitions="*,Auto">
            <Label Grid.Column="0" Text="Keep screen on while using OvertonesPlayground" VerticalOptions="Center" />
            <Switch AutomationId="settings-keep-screen-on" ToolTipProperties.Text="Keep the screen awake while the app is open." Grid.Column="1" IsToggled="{Binding KeepScreenOn}" />
        </Grid>

        <BoxView HeightRequest="1" />

        <Button AutomationId="settings-stop-all-audio" ToolTipProperties.Text="Stop everything that is playing." Text="Stop All Audio" controls:Icon.Glyph="{x:Static models:IconFont.Stop}" Command="{Binding StopAllAudioCommand}" />

        <Button AutomationId="settings-show-tips" Text="Show tips again" controls:Icon.Glyph="{x:Static models:IconFont.Lightbulb}" ToolTipProperties.Text="Show the one-time tips on the Library, Launchpad and Trim pages again" Command="{Binding ShowTipsAgainCommand}" />

        <Button AutomationId="settings-clear-library" ToolTipProperties.Text="Delete every clip from your library." Text="Clear Library" controls:Icon.Glyph="{x:Static models:IconFont.Delete}" TextColor="{DynamicResource SystemFillColorCritical}" Command="{Binding ClearLibraryCommand}" />

        <Label AutomationId="settings-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" />

        <BoxView HeightRequest="1" />

        <Label AutomationId="settings-version" Text="{Binding AppVersion, StringFormat='OvertonesPlayground v{0}'}" TextColor="{DynamicResource TextFillColorSecondary}" />

    </VerticalStackLayout>

</ContentPage>
