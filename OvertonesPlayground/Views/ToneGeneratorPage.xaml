<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:models="clr-namespace:OvertonesPlayground.Models"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.ToneGeneratorPage" AutomationId="tonegenerator-page" SafeAreaEdges="All"
             x:DataType="vm:ToneGeneratorViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Style="{StaticResource SubtitleTextBlockStyle}" Text="🎼 Synth Tone" />
            <Label Style="{StaticResource CaptionTextBlockStyle}" Text="Tune it, Generate &amp; Play to preview, then Save to keep it in your library (and your device's Music folder)."
                   TextColor="{DynamicResource TextFillColorSecondary}" />

            <Label Style="{StaticResource BodyStrongTextBlockStyle}" Text="Presets" />
            <CollectionView AutomationId="tonegenerator-presets" ItemsSource="{Binding Presets}" HeightRequest="56">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:TonePreset">
                        <Button AutomationId="{Binding AutomationKey, StringFormat='tonegenerator-preset-{0}'}" Text="{Binding Name}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ToneGeneratorViewModel}}, Path=SelectPresetCommand}"
                                CommandParameter="{Binding .}" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowSpacing="14">
                <Label Grid.Row="0" Grid.Column="0" Text="Wave" VerticalOptions="Center" />
                <Picker AutomationId="tonegenerator-wave" Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding WaveformOptions}"
                        SelectedItem="{Binding SelectedWaveform}" />
            </Grid>

            <controls:LabeledSlider AutomationId="tonegenerator-frequency" LabelText="Frequency" Minimum="{x:Static vm:ToneGeneratorViewModel.MinFrequencyHz}" Maximum="{x:Static vm:ToneGeneratorViewModel.MaxFrequencyHz}" Digits="0" IsEnabled="{Binding IsFrequencyRelevant}" Value="{Binding FrequencyHz}" />
            <controls:LabeledSlider AutomationId="tonegenerator-duration" LabelText="Duration" Minimum="{x:Static vm:ToneGeneratorViewModel.MinDurationSeconds}" Maximum="{x:Static vm:ToneGeneratorViewModel.MaxDurationSeconds}" Digits="2" Value="{Binding DurationSeconds}" />
            <controls:LabeledSlider AutomationId="tonegenerator-level" LabelText="Level" Minimum="0" Maximum="1" Digits="2" Value="{Binding Amplitude}" />

            <HorizontalStackLayout Spacing="12">
                <Button AutomationId="tonegenerator-generate" Style="{StaticResource AccentButtonStyle}" Text="▶ Generate &amp; Play" Command="{Binding GenerateCommand}" />
                <Button AutomationId="tonegenerator-save" Style="{StaticResource AccentButtonStyle}" Text="💾 Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" />
            </HorizontalStackLayout>

            <GraphicsView SemanticProperties.Description="Waveform preview of the generated tone" AutomationId="tonegenerator-waveform" x:Name="WaveformView" HeightRequest="120" BackgroundColor="{DynamicResource SolidBackgroundFillColorTertiary}" />

            <ActivityIndicator AutomationId="tonegenerator-busy" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label AutomationId="tonegenerator-status" Text="{Binding StatusMessage}" TextColor="{DynamicResource TextFillColorSecondary}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
