<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:OvertonesPlayground.ViewModels"
             xmlns:controls="clr-namespace:OvertonesPlayground.Controls"
             x:Class="OvertonesPlayground.Views.ToneGeneratorPage"
             x:DataType="vm:ToneGeneratorViewModel"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label Text="Synth Tone" FontSize="20" FontAttributes="Bold" />
            <Label Text="Tune it, Generate &amp; Play to preview, then Save to keep it in your library (and your device's Music folder)."
                   FontSize="12" TextColor="{StaticResource Gray500}" />

            <Grid ColumnDefinitions="Auto,*" RowSpacing="14">
                <Label Grid.Row="0" Grid.Column="0" Text="Wave" VerticalOptions="Center" />
                <Picker Grid.Row="0" Grid.Column="1"
                        ItemsSource="{Binding WaveformOptions}"
                        SelectedItem="{Binding SelectedWaveform}" />
            </Grid>

            <controls:LabeledSlider LabelText="Frequency" Minimum="20" Maximum="2000" Digits="0" Value="{Binding FrequencyHz}" />
            <controls:LabeledSlider LabelText="Duration" Minimum="0.1" Maximum="3" Digits="2" Value="{Binding DurationSeconds}" />
            <controls:LabeledSlider LabelText="Level" Minimum="0" Maximum="1" Digits="2" Value="{Binding Amplitude}" />

            <HorizontalStackLayout Spacing="12">
                <Button Text="Generate &amp; Play" Command="{Binding GenerateCommand}" />
                <Button Text="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}" BackgroundColor="{StaticResource Tertiary}" />
            </HorizontalStackLayout>

            <GraphicsView x:Name="WaveformView" HeightRequest="120" BackgroundColor="{StaticResource Gray950}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding StatusMessage}" TextColor="{StaticResource Gray500}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
