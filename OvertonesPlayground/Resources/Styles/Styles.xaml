<?xml version="1.0" encoding="UTF-8" ?>
<!-- Fluent (WinUI 3) styling for every control the app uses.

     Colors come from the token dictionaries in Themes/ (FluentLight / FluentDark, converted from WinUI's ThemeDictionaries)
     and are read with {DynamicResource}: FluentTheme swaps the dictionary when the theme changes, and DynamicResource is what
     makes the running UI follow. Sizes and radii come from Themes/FluentMetrics.xaml and are theme-independent, so they use
     {StaticResource}. Never write a color literal or an AppThemeBinding here or on a page; add or reuse a token. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ===== Type ramp (WinUI's TextBlock styles). Body is the default for every Label. ===== -->
    <Style x:Key="BodyTextBlockStyle" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLineHeight}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}" />

    <Style x:Key="CaptionTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource CaptionFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource CaptionLineHeight}" />
    </Style>

    <Style x:Key="BodyStrongTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
    </Style>

    <Style x:Key="BodyLargeTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontSize" Value="{StaticResource BodyLargeFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource BodyLargeLineHeight}" />
    </Style>

    <Style x:Key="SubtitleTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource SubtitleFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource SubtitleLineHeight}" />
    </Style>

    <Style x:Key="TitleTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource TitleFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource TitleLineHeight}" />
    </Style>

    <Style x:Key="TitleLargeTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource TitleLargeFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource TitleLargeLineHeight}" />
    </Style>

    <Style x:Key="DisplayTextBlockStyle" TargetType="Label" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="{StaticResource DisplayFontSize}" />
        <Setter Property="LineHeight" Value="{StaticResource DisplayLineHeight}" />
    </Style>

    <!-- ===== Button: Standard (default) and Accent (the page's primary action). Interactive controls are at least 48 dp
           (Android's touch-target guidance), larger than WinUI's 32. ===== -->
    <Style x:Key="DefaultButtonStyle" TargetType="Button">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorDefault}" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorTertiary}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ControlFillColorTransparent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}" />

    <Style x:Key="AccentButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="BorderColor" Value="{DynamicResource ControlStrokeColorOnAccentDefault}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorTertiary}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentFillColorDisabled}" />
                            <Setter Property="TextColor" Value="{DynamicResource TextOnAccentFillColorDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ControlFillColorTransparent}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ImageButton">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SubtleFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SubtleFillColorTertiary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ===== Text input (WinUI TextBox / ComboBox). The rounded, stroked box itself is drawn on Android by
           Platforms/Android/FluentTextInputs.cs, because a MAUI Entry has no border or corner properties. ===== -->
    <Style x:Key="DefaultTextInputStyle" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Entry" BasedOn="{StaticResource DefaultTextInputStyle}" />

    <Style x:Key="InvalidEntryStyle" TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource SystemFillColorCritical}" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Picker">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="TitleColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="TitleColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="DatePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="TimePicker">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchBar">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="CancelButtonColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlFillColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="PlaceholderColor" Value="{DynamicResource TextFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="SearchHandler">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    </Style>

    <!-- ===== Selection and range controls: accent-filled ===== -->
    <Style TargetType="Slider">
        <Setter Property="MinimumTrackColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource ControlStrongFillColorDefault}" />
        <Setter Property="ThumbColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="MinimumTrackColor" Value="{DynamicResource AccentFillColorDisabled}" />
                            <Setter Property="MaximumTrackColor" Value="{DynamicResource ControlStrongFillColorDisabled}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource AccentFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="Switch">
        <Setter Property="OnColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="ThumbColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{DynamicResource AccentFillColorDisabled}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource TextFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="On">
                        <VisualState.Setters>
                            <Setter Property="OnColor" Value="{DynamicResource AccentFillColorDefault}" />
                            <Setter Property="ThumbColor" Value="{DynamicResource TextOnAccentFillColorPrimary}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Off">
                        <VisualState.Setters>
                            <Setter Property="ThumbColor" Value="{DynamicResource TextFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="CheckBox">
        <Setter Property="Color" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="Color" Value="{DynamicResource ControlStrongFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderColor" Value="{DynamicResource ControlStrongStrokeColorDefault}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="MinimumWidthRequest" Value="{StaticResource ControlMinimumSize}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{DynamicResource TextFillColorDisabled}" />
                            <Setter Property="BorderColor" Value="{DynamicResource ControlStrongStrokeColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ProgressBar">
        <Setter Property="ProgressColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="ProgressColor" Value="{DynamicResource ControlStrongFillColorDisabled}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{DynamicResource AccentFillColorDefault}" />
    </Style>

    <Style TargetType="RefreshView">
        <Setter Property="RefreshColor" Value="{DynamicResource AccentFillColorDefault}" />
    </Style>

    <Style TargetType="IndicatorView">
        <Setter Property="IndicatorColor" Value="{DynamicResource ControlStrongFillColorDefault}" />
        <Setter Property="SelectedIndicatorColor" Value="{DynamicResource AccentFillColorDefault}" />
    </Style>

    <!-- ===== Surfaces ===== -->
    <!-- Every plain Border is a Fluent card: a layer just above the page, hairline stroke, 8 dp corners. Pages that need a
         different shape (a flat panel, a circle) set StrokeShape themselves. -->
    <Style TargetType="Border">
        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundFillColorDefault}" />
        <Setter Property="Stroke" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
        <Setter Property="Shadow" Value="{DynamicResource CardShadow}" />
    </Style>

    <Style TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource DividerStrokeColorDefault}" />
    </Style>

    <Style TargetType="SwipeItem">
        <Setter Property="BackgroundColor" Value="{DynamicResource ControlSolidFillColorDefault}" />
    </Style>

    <!-- ===== Pages and navigation ===== -->
    <Style TargetType="Page" ApplyToDerivedTypes="True">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SolidBackgroundFillColorBase}" />
    </Style>

    <Style TargetType="Shell" ApplyToDerivedTypes="True">
        <Setter Property="Shell.BackgroundColor" Value="{DynamicResource SolidBackgroundFillColorBase}" />
        <Setter Property="Shell.ForegroundColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.TitleColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="Shell.DisabledColor" Value="{DynamicResource TextFillColorDisabled}" />
        <Setter Property="Shell.UnselectedColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="Shell.NavBarHasShadow" Value="False" />
        <Setter Property="Shell.FlyoutBackgroundColor" Value="{DynamicResource SolidBackgroundFillColorSecondary}" />
        <Setter Property="Shell.FlyoutBackdrop" Value="{DynamicResource SmokeFillColorDefaultBrush}" />
        <Setter Property="Shell.TabBarBackgroundColor" Value="{DynamicResource SolidBackgroundFillColorBase}" />
        <Setter Property="Shell.TabBarForegroundColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="Shell.TabBarTitleColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="Shell.TabBarUnselectedColor" Value="{DynamicResource TextFillColorSecondary}" />
    </Style>

    <!-- Flyout items: WinUI's NavigationView look. The selected item gets a subtle fill (the accent bar WinUI adds beside it
         is not reproducible in the default Shell template). -->
    <Style TargetType="Label" Class="FlyoutItemLabelStyle">
        <Setter Property="TextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="{StaticResource BodyFontSize}" />
    </Style>

    <Style TargetType="Grid" ApplyToDerivedTypes="True" Class="FlyoutItemLayoutStyle">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Selected">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SubtleFillColorSecondary}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style TargetType="NavigationPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource SolidBackgroundFillColorBase}" />
        <Setter Property="BarTextColor" Value="{DynamicResource TextFillColorPrimary}" />
        <Setter Property="IconColor" Value="{DynamicResource TextFillColorPrimary}" />
    </Style>

    <Style TargetType="TabbedPage">
        <Setter Property="BarBackgroundColor" Value="{DynamicResource SolidBackgroundFillColorBase}" />
        <Setter Property="BarTextColor" Value="{DynamicResource AccentFillColorDefault}" />
        <Setter Property="UnselectedTabColor" Value="{DynamicResource TextFillColorSecondary}" />
        <Setter Property="SelectedTabColor" Value="{DynamicResource AccentFillColorDefault}" />
    </Style>

</ResourceDictionary>
