<?xml version="1.0" encoding="utf-8" ?>
<!-- Fluent values that do not change with the light/dark theme, so they live outside the swapped theme dictionaries and
     are consumed with {StaticResource}. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Converted from the root-level entries of the WinUI file. Durations are in milliseconds (what MAUI's animation APIs
         take). MAUI has no key-spline easing; "0,0,0,1" (fast out, slow in) is closest to Easing.CubicOut. -->
    <x:String x:Key="ControlFastOutSlowInKeySpline">0,0,0,1</x:String>
    <x:Int32 x:Key="ControlNormalAnimationDuration">250</x:Int32>
    <x:Int32 x:Key="ControlFastAnimationDuration">167</x:Int32>
    <x:Int32 x:Key="ControlFastAnimationAfterDuration">168</x:Int32>
    <x:Int32 x:Key="ControlFasterAnimationDuration">83</x:Int32>

    <!-- Shape: Fluent rounds controls by 4 and overlays and cards by 8. -->
    <x:Int32 x:Key="ControlCornerRadius">4</x:Int32>
    <x:Int32 x:Key="OverlayCornerRadius">8</x:Int32>

    <!-- Fluent's own minimum is 32, but a finger needs more: interactive controls are at least 48 dp (Android's guidance). -->
    <x:Double x:Key="ControlMinimumSize">48</x:Double>

    <!-- The Fluent type ramp (font size / line height in dp). LineHeight below is the multiplier MAUI expects. Fluent's
         typeface is Segoe UI Variable, which Android does not have, so the app keeps its bundled Open Sans. -->
    <x:Double x:Key="CaptionFontSize">12</x:Double>
    <x:Double x:Key="CaptionLineHeight">1.33</x:Double>
    <x:Double x:Key="BodyFontSize">14</x:Double>
    <x:Double x:Key="BodyLineHeight">1.43</x:Double>
    <x:Double x:Key="BodyLargeFontSize">18</x:Double>
    <x:Double x:Key="BodyLargeLineHeight">1.33</x:Double>
    <x:Double x:Key="SubtitleFontSize">20</x:Double>
    <x:Double x:Key="SubtitleLineHeight">1.4</x:Double>
    <x:Double x:Key="TitleFontSize">28</x:Double>
    <x:Double x:Key="TitleLineHeight">1.29</x:Double>
    <x:Double x:Key="TitleLargeFontSize">40</x:Double>
    <x:Double x:Key="TitleLargeLineHeight">1.3</x:Double>
    <x:Double x:Key="DisplayFontSize">68</x:Double>
    <x:Double x:Key="DisplayLineHeight">1.35</x:Double>
</ResourceDictionary>
