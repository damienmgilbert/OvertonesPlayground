<Project Sdk="Microsoft.NET.Sdk">

	<!-- Offline tool that runs the Launchpad project generator over every style, kit and many seeds against the committed sample
	     catalog, scores what comes out, and proposes the ready-made presets that ship in the ontology's Data/styles.json. It
	     compiles the app's Launchpad model and generator sources directly (they have no MAUI dependency), like the tests do. -->
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>preview</LangVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>ProjectForge</RootNamespace>
		<AssemblyName>ProjectForge</AssemblyName>
		<InvariantGlobalization>true</InvariantGlobalization>
		<NoWarn>$(NoWarn);CA1303;CA1305;CA1307;CA1308;CA1031;CA1062;CA1812;CA2007;CA5394;IDE0058;IDE0290;IDE0028;IDE0301;IDE0072;IDE0010;IDE0045;IDE0046;IDE0060;IDE0047;IDE0048</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\OvertonesPlayground.Ontology\OvertonesPlayground.Ontology.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\..\OvertonesPlayground\Models\Launchpad*.cs" Exclude="..\..\OvertonesPlayground\Models\LaunchpadTutorial.cs" Link="Linked\Models\%(Filename)%(Extension)" />
		<Compile Include="..\..\OvertonesPlayground\Models\PatternDirection.cs" Link="Linked\Models\PatternDirection.cs" />
		<Compile Include="..\..\OvertonesPlayground\Services\Implementations\LaunchpadExampleBuilder.cs" Link="Linked\Services\LaunchpadExampleBuilder.cs" />
		<Compile Include="..\..\OvertonesPlayground\Services\Implementations\LaunchpadGenerator.cs" Link="Linked\Services\LaunchpadGenerator.cs" />
		<Compile Include="..\..\OvertonesPlayground\Services\Implementations\LaunchpadQuality.cs" Link="Linked\Services\LaunchpadQuality.cs" />
		<Compile Include="..\..\OvertonesPlayground\Services\Implementations\LaunchpadRecipe.cs" Link="Linked\Services\LaunchpadRecipe.cs" />
	</ItemGroup>

</Project>
